# ---------------------------------------------------------------- config

def split_list(value):
    """Comma- or newline-separated items."""
    return [m.strip() for m in re.split(r"[,\n]", value or "") if m.strip()]


def split_patterns(value):
    """Keywords: like split_list, but an item written /like this/ is a regex and may hold commas."""
    return [m.strip() for m in re.findall(r"(?:^|(?<=[,\n]))\s*/(?:\\.|[^/\n])+/(?=\s*(?:,|\n|$))|[^,\n]+", value or "")
            if m.strip()]


def load_config(path=CONFIG):
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str  # place names keep their case
    cfg.read_string(DEFAULTS)
    if os.path.exists(path):
        cfg.read(path, encoding="utf-8")
    return cfg


def expand(p):
    return os.path.abspath(os.path.expanduser(os.path.expandvars(p.strip())))


# ---------------------------------------------------------------- places

class Place(object):
    def __init__(self, name, path):
        self.name = name
        self.path = path
        self.desc = ""
        self.doc = ""


def read_head(path, limit):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read(limit)
    except OSError:
        return ""


def clean_md(s):
    s = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", s)
    s = s.replace("**", "").replace("__", "").replace("`", "")
    return re.sub(r"\s+", " ", s).strip()


BOILERPLATE = re.compile(r"provides guidance to (claude|codex|ai)|guidance for claude code|project context for claude|"
                         r"instructions for (ai|coding) agents|^(this|the) file (is|holds|provides)", re.I)
GENERIC_TITLES = {"agents.md", "claude.md", "readme", "readme.md", "overview", "project overview", "about",
                  "introduction", "description", "agent guide", "notes"}


def summarize(text, limit=240):
    """The first heading and the first paragraph of prose under it, past agent-file boilerplate."""
    title, para, in_code, front = "", [], False, False
    for i, line in enumerate(text.splitlines() + [""]):
        s = line.strip()
        if i == 0 and s == "---":
            front = True
            continue
        if front:
            front = s != "---"
            continue
        if s.startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            continue
        if s.startswith("#"):
            if para:
                break
            h = clean_md(s.lstrip("#").strip())
            h = re.sub(r"^(agents|claude|readme)\.md\s*[-—:]+\s*", "", h, flags=re.I)
            if not title and h.lower().rstrip(":") not in GENERIC_TITLES:
                title = h
            continue
        if not s or s[0] in "|<![>" or set(s) <= set("-=*_"):
            if para:
                if BOILERPLATE.search(" ".join(para)):
                    para = []
                    continue
                break
            continue
        para.append(s.lstrip("-* "))
    out = clean_md(title + (": " if title and para else "") + " ".join(para))
    if len(out) > limit:
        out = out[:limit].rsplit(" ", 1)[0] + " …"
    return out


def discover(cfg):
    sec = cfg["drover"]
    ignore = [re.compile(fnmatch_re(g)) for g in split_list(sec.get("ignore"))]
    found = []
    for root in split_list(sec.get("roots")):
        root = expand(root)
        if not os.path.isdir(root):
            continue
        for entry in sorted(os.listdir(root), key=str.lower):
            path = os.path.join(root, entry)
            if entry.startswith(".") or not os.path.isdir(path) or any(r.match(entry) for r in ignore):
                continue
            if any(os.path.exists(os.path.join(path, m)) for m in MARKERS):
                found.append((entry, path))
    for p in split_list(sec.get("places")):
        path = expand(p)
        if os.path.isdir(path):
            found.append((os.path.basename(path), path))
    places, seen = [], set()
    for name, path in found:
        if path in seen:
            continue
        seen.add(path)
        if name.lower() in (p.name.lower() for p in places):
            name = os.path.basename(os.path.dirname(path)) + "/" + name
        place = Place(name, path)
        for f in DOC_FILES:
            if os.path.isfile(os.path.join(path, f)):
                place.doc = read_head(os.path.join(path, f), 12000)
                place.desc = summarize(place.doc)
                break
        if cfg.has_option("describe", name):
            place.desc = cfg.get("describe", name).strip()
        places.append(place)
    return places


def fnmatch_re(glob_pattern):
    import fnmatch
    return fnmatch.translate(glob_pattern)


def by_name(places, name):
    name = (name or "").strip().lower()
    for p in places:
        if p.name.lower() == name:
            return p
    return None


def place_for_path(path, places, moved=None, loose=False):
    """The place a path lies in. moved maps old prefixes to new ones; loose also matches a
    component of a path that no longer exists against the place names (for old history)."""
    path = expand(path)
    for old, new in (moved or {}).items():
        if path == old or path.startswith(old.rstrip("/") + "/"):
            path = new + path[len(old.rstrip("/")):]
            break
    best = None
    for p in places:
        if path == p.path or path.startswith(p.path.rstrip("/") + "/"):
            if best is None or len(p.path) > len(best.path):
                best = p
    if best or not loose or not path.startswith(HOME + "/"):
        return best
    for comp in path[len(HOME) + 1:].split("/"):
        hit = by_name(places, comp)
        if hit:
            return hit
    return None


def moved_map(cfg):
    return {expand(k): expand(v) for k, v in cfg.items("moved") if k not in cfg.defaults()}


# ---------------------------------------------------------------- text

def clean_task(task):
    task = re.sub(r"</?pasted_content[^>]*>", "", task)
    return task.strip()


def tokens(text, stem=6):
    out = []
    for w in re.findall(r"[^\W\d_]{2,}|\d{3,}", text.lower()):
        if w in STOPWORDS:
            continue
        out.append(w[:stem] if stem else w)
    return out


def title_of(task, words=6):
    first = next((l for l in task.splitlines() if l.strip()), "")
    w = re.sub(r"https?://\S+", "", first).split()
    t = " ".join(w[:words])
    return (t[:48].rsplit(" ", 1)[0] if len(t) > 48 else t) or "task"


# ---------------------------------------------------------------- BM25 over past tasks

class BM25(object):
    def __init__(self, k1=1.2, b=0.75):
        self.k1, self.b = k1, b
        self.post = defaultdict(list)
        self.lens = []
        self.labels = []

    def add(self, toks, label):
        i = len(self.lens)
        self.lens.append(len(toks))
        self.labels.append(label)
        for t, n in Counter(toks).items():
            self.post[t].append((i, n))

    def query(self, toks, k=10):
        n = len(self.lens)
        if not n or not toks:
            return []
        avg = sum(self.lens) / float(n)
        scores = defaultdict(float)
        for t in set(toks):
            plist = self.post.get(t)
            if not plist:
                continue
            idf = math.log(1 + (n - len(plist) + 0.5) / (len(plist) + 0.5))
            for i, tf in plist:
                scores[i] += idf * tf * (self.k1 + 1) / (tf + self.k1 * (1 - self.b + self.b * self.lens[i] / avg))
        top = sorted(scores.items(), key=lambda kv: -kv[1])[:k]
        return [(s, self.labels[i], i) for i, s in top]


class History(object):
    """Past tasks with the place each ran in: BM25 over them, and how often a place's name in a task
    meant that place."""

    def __init__(self):
        self.bm25 = BM25()
        self.tasks = []
        self.lower = []
        self.labels = []
        self.stamps = []

    def add(self, task, label, ts=""):
        self.bm25.add(tokens(task), label)
        self.tasks.append(task)
        self.lower.append(task.lower())
        self.labels.append(label)
        self.stamps.append(ts or "")

    def query(self, task, k=10):
        return self.bm25.query(tokens(task), k)

    def recent(self, days=30, now=None, top=15):
        """The places past sessions ran in most over the last days."""
        cut = (now or datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)) - datetime.timedelta(days=days)
        c = Counter(l for l, ts in zip(self.labels, self.stamps) if ts and ts >= cut.strftime("%Y-%m-%dT%H:%M"))
        return c.most_common(top)

    def name_record(self, name):
        """(past tasks naming it, of those that ran in it)"""
        pat = mention_re(name.lower())
        n = k = 0
        for t, label in zip(self.lower, self.labels):
            if pat.search(t):
                n += 1
                k += label == name
        return n, k


def vote(hits):
    """Score-weighted votes of the nearest past tasks: (best place, its share, best score)."""
    if not hits:
        return None, 0.0, 0.0
    w = defaultdict(float)
    for s, label, _ in hits:
        w[label] += s
    best = max(w, key=w.get)
    return best, w[best] / sum(w.values()), hits[0][0]


# ---------------------------------------------------------------- Claude Code history

def history_records(cfg):
    """First real prompt and cwd of every interactive Claude Code session, cached by file mtime."""
    root = expand(cfg.get("drover", "history"))
    cache_file = os.path.join(CACHE, "history.json")
    try:
        with open(cache_file, encoding="utf-8") as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    out, fresh = [], {}
    for path in glob.glob(os.path.join(root, "*", "*.jsonl")):
        try:
            st = os.stat(path)
        except OSError:
            continue
        key = "%d:%d" % (st.st_mtime, st.st_size)
        hit = cache.get(path)
        rec = hit[1] if hit and hit[0] == key else first_prompt(path)
        fresh[path] = [key, rec]
        if rec and rec.get("entry") == "cli":
            out.append(rec)
    try:
        os.makedirs(CACHE, exist_ok=True)
        with open(cache_file + ".tmp", "w", encoding="utf-8") as f:
            json.dump(fresh, f, ensure_ascii=False)
        os.replace(cache_file + ".tmp", cache_file)
    except OSError:
        pass
    out.sort(key=lambda r: r.get("ts") or "")
    return out


def first_prompt(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for n, line in enumerate(f):
                if n > 400:
                    return None
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("type") != "user" or d.get("isMeta") or d.get("isSidechain"):
                    continue
                c = (d.get("message") or {}).get("content")
                if isinstance(c, list):
                    c = "\n".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
                if not isinstance(c, str):
                    continue
                s = c.strip()
                if not s or s.startswith(("<command-", "<local-command", "Caveat:", "<system-reminder", "<bash-")):
                    continue
                return {"ts": d.get("timestamp"), "cwd": d.get("cwd"), "entry": d.get("entrypoint"),
                        "task": clean_task(s)[:4000]}
    except OSError:
        pass
    return None


def history_index(cfg, places, records=None):
    moved = moved_map(cfg)
    idx = History()
    for r in records if records is not None else history_records(cfg):
        p = place_for_path(r["cwd"] or "", places, moved, loose=True)
        if p:
            idx.add(r["task"], p.name, r.get("ts"))
    return idx


# ---------------------------------------------------------------- the rules

PATH_RE = re.compile(r"(?:~|/)[^\s'\"`<>|()\[\]{},;]+")
REL_RE = re.compile(r"(?<![\w/~.:-])([\w.-]+(?:/[\w.-]+)+)")
REPO_WORDS = r"(?:repo|repository|project|folder|directory|dir|clone|repo's)"


ANCHOR_RE = re.compile(r"(?:\bwork(?:ing)? in|\brepo(?:s|sitory)?:?|\bcd|\bcwd:?|\bworking directory:?)\s*[`'\"]?$", re.I)
COLON_RE = re.compile(r"(?:^|\n|\.\s)\s*in\s*[`'\"]?$", re.I)  # "In ~/x: do this" at the start of a sentence


def by_paths(task, places, moved):
    """The place the task's paths lie in: the first one written as "work in X", "repo: X", "in X:" or
    "cd X" if any, else the one with the most paths, the earliest on a tie."""
    text = re.sub(r"[a-z][a-z0-9+.-]*://\S+", " ", task)
    votes, first, anchored = Counter(), {}, []

    def hit(name, start, end):
        votes[name] += 1
        first.setdefault(name, start)
        before = text[max(0, start - 24):start]
        if ANCHOR_RE.search(before) or (COLON_RE.search(before) and text[end:end + 2].lstrip("`'\"").startswith(":")):
            anchored.append((start, name))

    for m in PATH_RE.finditer(text):
        raw = m.group(0).rstrip(".,:;!?'\"$#")
        if raw in ("/", "~", "~/") or (raw.startswith("/") and raw.count("/") < 2):
            continue
        p = place_for_path(raw, places, moved)
        if p:
            hit(p.name, m.start(), m.start() + len(raw))
    for m in REL_RE.finditer(text):
        rel = m.group(1).rstrip(".,:;!?")
        head, _, rest = rel.partition("/")
        named = by_name(places, head)
        if named and rest and os.path.exists(os.path.join(named.path, rest)):
            hits = [named]
        elif "." in rel.rsplit("/", 1)[-1] or rel.count("/") >= 2:
            hits = [p for p in places if os.path.exists(os.path.join(p.path, rel))]
        else:
            hits = []
        if len(hits) == 1:
            hit(hits[0].name, m.start(), m.start() + len(rel))
    if anchored:
        return min(anchored)[1], True
    if not votes:
        return None, False
    return sorted(votes, key=lambda n: (-votes[n], first[n]))[0], False


def distinctive(name):
    return bool(re.search(r"[.\-_0-9]", name))


def mention_re(low_name):
    return re.compile(r"(?<![\w.@/-])@?" + re.escape(low_name) + r"(?![\w-]|\.\w)")


def by_names(task, places, history=None):
    """Places named in the task: (strong, weak). A name is strong when it is written @name or
    beside the word repo; when past tasks that named it mostly ran in it; or, with fewer than
    three such tasks, when it has a dot, dash, underscore or digit, as an ordinary word does not."""
    low = task.lower()
    strong, weak = [], []
    for p in places:
        n = p.name.lower()
        if len(n) < 2:
            continue
        m = mention_re(n).search(low)
        if not m:
            continue
        before, after = low[max(0, m.start() - 14):m.start()], low[m.end():m.end() + 14]
        ctx = (m.group(0).startswith("@")
               or re.search(REPO_WORDS + r"\s+$", before) or re.match(r"\s+" + REPO_WORDS, after))
        seen, right = history.name_record(p.name) if history is not None else (0, 0)
        if ctx:
            ok = True
        elif seen >= 3:
            ok = right >= 0.5 * seen
        else:
            ok = distinctive(n)
        (strong if ok else weak).append((m.start(), p.name))
    order = lambda lst: [n for _, n in sorted(lst)]
    return order(strong), order(weak)


def by_keywords(task, cfg, places):
    hits = Counter()
    for name, value in cfg.items("keywords"):
        if name in cfg.defaults() or not by_name(places, name):
            continue
        for kw in split_patterns(value):
            if len(kw) > 2 and kw.startswith("/") and kw.endswith("/"):
                pat = kw[1:-1]
            else:
                pat = r"(?<![\w-])" + re.escape(kw) + r"(?![\w-])"
            try:
                if re.search(pat, task, re.I):
                    hits[by_name(places, name).name] += 1
            except re.error as e:
                sys.stderr.write("drover: bad keyword %r for %s: %s\n" % (kw, name, e))
    return [n for n, _ in hits.most_common()]


def route(task, places, cfg, index=None, use_model=True, context="", explicit=None, now=None):
    """Returns dict(place, how, why, title, hints). now: the moment to route as of (for eval)."""
    task = clean_task(task)
    moved = moved_map(cfg)
    hints = []
    hist_best = None
    examples = []

    def done(place, how, why, title=None):
        return {"place": place, "how": how, "why": why, "title": title or title_of(task), "hints": hints}

    if explicit:
        p = by_name(places, explicit) or place_for_path(explicit, places)
        if p:
            return done(p.name, "explicit", explicit)
        if os.path.isdir(expand(explicit)):
            return done(expand(explicit), "explicit", "a directory outside the places")
        raise SystemExit("drover: no place or directory %r" % explicit)
    m = re.match(r"\s*@([^\s,:]+)[\s,:]*", task)
    if m and by_name(places, m.group(1)):
        task = task[m.end():]
        return done(by_name(places, m.group(1)).name, "explicit", "@" + m.group(1))

    name, anchored = by_paths(task, places, moved)
    if anchored:
        return done(name, "path", "the task says to work there")

    # The rest decide only together: each confident signal names one place, and if they all name the
    # same one it is taken; if they disagree, or there is none, the model weighs them.
    signals = []  # (how, place, why)
    if name:
        signals.append(("path", name, "a path in the task lies in it"))
    strong, weak = by_names(task, places, index)
    if len(strong) == 1:
        signals.append(("name", strong[0], "the task names it"))
    if strong or weak:
        hints.append("places named in the task: " + ", ".join(strong + weak))
    kw = by_keywords(task, cfg, places)
    if len(kw) == 1:
        signals.append(("keyword", kw[0], "a [keywords] entry matches"))
    if kw:
        hints.append("keyword matches: " + ", ".join(kw))
    if index is not None:
        hits = index.query(task, k=10)
        best, share, top = vote(hits)
        hist_best = best
        examples = [(label, index.tasks[i]) for _, label, i in hits[:6]]
        sec = cfg["drover"]
        if best and top >= float(sec.get("history_min_score")) and share >= float(sec.get("history_min_share")):
            signals.append(("history", best, "similar past tasks ran there (share %.2f, score %.1f)" % (share, top)))
        if best:
            w = Counter()
            for sc, label, _ in hits:
                w[label] += sc
            hints.append("similar past tasks ran in: " + ", ".join("%s (%.0f%%)" % (n, 100 * v / sum(w.values()))
                                                                   for n, v in w.most_common(4)))
    if name:
        hints.insert(0, "a path in the task lies in: " + name)
    if len(set(p for _, p, _ in signals)) == 1:
        how, place, why = signals[0]
        if len(signals) > 1:
            why += "; " + ", ".join(h for h, _, _ in signals[1:]) + " agree"
        return done(place, how, why)

    if use_model and cfg.get("model", "endpoints").strip():
        try:
            usage = index.recent(now=now) if index is not None else []
            pick = ask_model(task, places, cfg, hints, context, usage, examples)
        except ModelError as e:
            sys.stderr.write("drover: model: %s\n" % e)
            pick = None
        if pick:
            return done(pick["place"], "model", pick.get("why") or "", pick.get("title"))

    if signals or hist_best:
        how, place, why = signals[0] if signals else ("history", hist_best, "")
        return done(place, "guess", "no model answer; took the %s signal" % how)
    default = cfg.get("drover", "default").strip()
    if default:
        p = by_name(places, default) or place_for_path(default, places)
        return done(p.name if p else expand(default), "default", "nothing decided")
    return done(None, "none", "nothing decided and no default place")


# ---------------------------------------------------------------- the model

class ModelError(Exception):
    pass


SYSTEM = """You route a task to the project directory where a coding agent will work on it. \
Each place below is a directory: its name and what its AGENTS.md or README says it is. Pick the one place \
whose subject the task is about. A task that names a place, a host, a service or a file that one place documents \
belongs there; a task that only reads or files something kept in another place still belongs where the work is \
done. The similar past tasks show where this user works on such things: follow them unless the task is plainly \
about another place. Between places with similar subjects prefer one that is in use now. If no place fits, pick \
"{default}".

Answer with JSON only: {{"place": "<a name from the list>", "title": "<the task in 3 to 6 words>"}}

Places:
{catalog}"""


def catalog(places):
    lines = []
    for p in places:
        line = "- " + p.name
        if p.desc:
            line += ": " + p.desc
        lines.append(line)
    return "\n".join(lines)


def ask_model(task, places, cfg, hints, context, usage=(), examples=()):
    m = cfg["model"]
    default = cfg.get("drover", "default").strip() or places[0].name
    system = SYSTEM.format(default=default, catalog=catalog(places))
    user = ""
    if usage:
        user += "Sessions per place over the last 30 days: " + ", ".join("%s %d" % u for u in usage) + "\n\n"
    if context:
        user += "Agents open now in herdr (place: what each works on):\n" + context + "\n\n"
    if examples:
        user += "The most similar past tasks and the place each ran in:\n" + "\n".join(
            "- %s: %s" % (label, re.sub(r"\s+", " ", t)[:220]) for label, t in examples) + "\n\n"
    if hints:
        user += "Signals the rules found, not decisive:\n" + "\n".join("- " + h for h in hints) + "\n\n"
    user += "Task:\n" + task[:6000]
    schema = {"type": "object", "additionalProperties": False, "required": ["place", "title"],
              "properties": {"place": {"type": "string", "enum": [p.name for p in places]},
                             "title": {"type": "string"}}}
    body = {"model": m.get("model"), "temperature": 0, "max_tokens": 80,
            "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}],
            "response_format": {"type": "json_schema",
                                "json_schema": {"name": "route", "strict": True, "schema": schema}}}
    try:
        body.update(json.loads(m.get("extra") or "{}"))
    except ValueError as e:
        raise ModelError("[model] extra is not JSON: %s" % e)
    errors = []
    for url in split_list(m.get("endpoints")):
        url = url.rstrip("/")
        if not url.endswith("/chat/completions"):
            url += "/chat/completions"
        req = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST",
                                     headers={"Content-Type": "application/json"})
        if m.get("api_key"):
            req.add_header("Authorization", "Bearer " + m.get("api_key"))
        try:
            with urllib.request.urlopen(req, timeout=float(m.get("timeout"))) as r:
                d = json.load(r)
            text = d["choices"][0]["message"]["content"] or ""
            js = json.loads(text[text.find("{"):text.rfind("}") + 1])
            p = by_name(places, js.get("place"))
            if not p:
                raise ValueError("unknown place %r" % js.get("place"))
            return {"place": p.name, "title": (js.get("title") or "").strip()[:48], "why": url.split("/")[2]}
        except (urllib.error.URLError, OSError, ValueError, KeyError, IndexError) as e:
            errors.append("%s: %s" % (url.split("/")[2], getattr(e, "reason", e)))
    raise ModelError("; ".join(errors) or "no endpoints")


# ---------------------------------------------------------------- herdr

class HerdrError(Exception):
    pass


def herdr(*args):
    try:
        r = subprocess.run(["herdr"] + list(args), capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        raise HerdrError("herdr is not on PATH")
    except subprocess.TimeoutExpired:
        raise HerdrError("herdr %s timed out" % " ".join(args))
    if r.returncode != 0:
        raise HerdrError((r.stderr or r.stdout).strip())
    try:
        return json.loads(r.stdout).get("result", {})
    except ValueError:
        return {}


def herdr_context(places):
    """What the agents open in herdr work on, one line per place, for the model."""
    try:
        panes = herdr("pane", "list").get("panes", [])
    except HerdrError:
        return ""
    lines = []
    for p in panes:
        place = place_for_path(p.get("cwd") or "", places)
        title = (p.get("terminal_title_stripped") or "").strip()
        if place and p.get("agent") and title:
            lines.append("- %s: %s" % (place.name, title))
    return "\n".join(sorted(set(lines)))


def find_workspace(place_name, path):
    spaces = herdr("workspace", "list").get("workspaces", [])
    for w in spaces:
        if (w.get("label") or "") == place_name:
            return w["workspace_id"]
    for p in herdr("pane", "list").get("panes", []):
        cwd = p.get("cwd") or ""
        if cwd == path or cwd.startswith(path.rstrip("/") + "/"):
            return p["workspace_id"]
    return None


def launch(place_name, path, title, task, cfg, focus=False):
    os.makedirs(os.path.join(STATE, "tasks"), exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y-%m-%d-%H%M%S")
    slug = re.sub(r"[^\w]+", "-", title.lower()).strip("-")[:40] or "task"
    file = os.path.join(STATE, "tasks", "%s-%s.md" % (stamp, slug))
    with open(file, "w", encoding="utf-8") as f:
        f.write(task)

    ws = find_workspace(place_name, path)
    if ws:
        r = herdr("tab", "create", "--workspace", ws, "--cwd", path, "--label", title, "--no-focus")
    else:
        r = herdr("workspace", "create", "--cwd", path, "--label", place_name, "--no-focus")
        ws = r["workspace"]["workspace_id"]
        herdr("tab", "rename", r["tab"]["tab_id"], title)
    tab, pane = r["tab"]["tab_id"], r["root_pane"]["pane_id"]

    try:  # the shell has drawn its prompt, so it reads what is typed
        herdr("pane", "wait-output", pane, "--regex", r"\S", "--timeout", "15000")
    except HerdrError:
        pass
    line = cfg.get("drover", "launch").format(command=cfg.get("drover", "command"), file=shlex.quote(file))
    herdr("pane", "run", pane, line)
    if focus:
        herdr("workspace", "focus", ws)
        herdr("tab", "focus", tab)

    agent = None
    for _ in range(40):
        try:
            agent = (herdr("agent", "get", pane).get("agent") or {}).get("agent")
            if agent:
                break
        except HerdrError:
            pass
        time.sleep(0.5)
    return {"workspace": ws, "tab": tab, "pane": pane, "file": file, "agent": agent}


# ---------------------------------------------------------------- commands

def log(entry):
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, "log.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError:
        pass


def cmd_route(argv):
    ap = argparse.ArgumentParser(prog="drover", description="Route a task to its project and start an agent there in herdr.")
    ap.add_argument("-n", "--dry-run", action="store_true", help="show where the task would go; start nothing")
    ap.add_argument("-C", "--dir", help="a place name or directory: skip routing")
    ap.add_argument("-f", "--focus", action="store_true", help="switch to the new tab")
    ap.add_argument("--no-model", action="store_true", help="rules only")
    ap.add_argument("--no-history", action="store_true", help="do not consult the Claude Code history")
    ap.add_argument("task", nargs="*", help="the task; read from stdin when absent")
    a = ap.parse_args(argv)
    task = " ".join(a.task).strip()
    if not task:
        if sys.stdin.isatty():
            sys.stderr.write("Task (finish with Ctrl-D on an empty line):\n")
        task = sys.stdin.read().strip()
    if not task:
        raise SystemExit("drover: no task")

    t0 = time.time()
    cfg = load_config()
    places = discover(cfg)
    if not places:
        raise SystemExit("drover: no places found; set roots in %s" % CONFIG)
    index = None if a.no_history else history_index(cfg, places)
    context = "" if a.no_model else herdr_context(places)
    d = route(task, places, cfg, index=index, use_model=not a.no_model, context=context, explicit=a.dir)
    elapsed = time.time() - t0
    if not d["place"]:
        raise SystemExit("drover: %s; name one with @place or set default in %s" % (d["why"], CONFIG))
    p = by_name(places, d["place"])
    name, path = (p.name, p.path) if p else (os.path.basename(d["place"]), d["place"])
    sys.stderr.write("→ %s  [%s: %s]  %.1fs\n" % (name, d["how"], d["why"], elapsed))
    for h in d["hints"]:
        sys.stderr.write("  %s\n" % h)
    entry = {"ts": datetime.datetime.now().isoformat(timespec="seconds"), "place": name, "how": d["how"],
             "why": d["why"], "title": d["title"], "seconds": round(elapsed, 2), "task": task[:500]}
    if a.dry_run:
        print(path)
        return
    body = re.sub(r"^\s*@[^\s,:]+[\s,:]*", "", task) if d["how"] == "explicit" and not a.dir else task
    try:
        r = launch(name, path, d["title"], body, cfg, focus=a.focus)
    except HerdrError as e:
        raise SystemExit("drover: herdr: %s" % e)
    entry.update(r)
    log(entry)
    sys.stderr.write("  %s · tab %s · pane %s · %s\n" % (
        r["workspace"], r["tab"], r["pane"], (r["agent"] + " started") if r["agent"] else "no agent detected in 20 s"))


def cmd_places(argv):
    cfg = load_config()
    for p in discover(cfg):
        print("%-28s %s" % (p.name, p.desc or "-"))


def cmd_eval(argv):
    ap = argparse.ArgumentParser(prog="drover eval",
                                 description="Replay the first prompt of each interactive Claude Code session "
                                             "through the router and compare with the directory it ran in.")
    ap.add_argument("--model", action="store_true", help="ask the model when the rules do not decide (slow)")
    ap.add_argument("--limit", type=int, default=0, help="only the last N sessions")
    ap.add_argument("--since", help="only sessions from this date (YYYY-MM-DD)")
    ap.add_argument("--wrong", action="store_true", help="list the misrouted tasks")
    ap.add_argument("--min-score", type=float, help="override history_min_score")
    ap.add_argument("--min-share", type=float, help="override history_min_share")
    a = ap.parse_args(argv)
    cfg = load_config()
    if a.min_score is not None:
        cfg.set("drover", "history_min_score", str(a.min_score))
    if a.min_share is not None:
        cfg.set("drover", "history_min_share", str(a.min_share))
    places = discover(cfg)
    moved = moved_map(cfg)
    recs = history_records(cfg)
    index = History()
    rows = []
    for r in recs:
        p = place_for_path(r["cwd"] or "", places, moved, loose=True)
        if not p or len(tokens(r["task"])) < 3:  # "ok", "c", a lone slash command: nothing to route by
            continue
        rows.append((r, p.name))
    test_from = 0
    if a.since:
        test_from = next((i for i, (r, _) in enumerate(rows) if (r["ts"] or "") >= a.since), len(rows))
    if a.limit:
        test_from = max(test_from, len(rows) - a.limit)
    stats = defaultdict(lambda: [0, 0])
    wrong = []
    for i, (r, label) in enumerate(rows):
        if i >= test_from:
            now = datetime.datetime.strptime(r["ts"][:16], "%Y-%m-%dT%H:%M") if r.get("ts") else None
            d = route(r["task"], places, cfg, index=index, use_model=a.model, now=now)
            ok = d["place"] == label
            stats[d["how"]][0] += 1
            stats[d["how"]][1] += ok
            if not ok:
                wrong.append((d["how"], label, d["place"], r["task"]))
        index.add(r["task"], label, r.get("ts"))  # later sessions learn from this one, as drover would
    total = sum(n for n, _ in stats.values())
    good = sum(k for _, k in stats.values())
    print("sessions %d (tested %d), places %d" % (len(rows), total, len(places)))
    for how in ("explicit", "path", "name", "keyword", "history", "model", "guess", "default", "none"):
        if how in stats:
            n, k = stats[how]
            print("  %-8s decided %4d (%4.1f%%)  right %4d (%5.1f%%)" % (how, n, 100.0 * n / total, k, 100.0 * k / n))
    print("  overall right %d of %d (%.1f%%)" % (good, total, 100.0 * good / max(total, 1)))
    if a.wrong:
        for how, label, got, task in wrong:
            print("\n[%s] ran in %s, routed to %s:\n  %s" % (how, label, got, task[:300].replace("\n", " ")))


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "places":
        return cmd_places(argv[1:])
    if argv and argv[0] == "eval":
        return cmd_eval(argv[1:])
    return cmd_route(argv)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
